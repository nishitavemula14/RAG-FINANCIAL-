# Directory containing any supported knowledge documents
DATA_DIR=data/raw
INDEX_DIR=chroma_db
CHUNK_SIZE=900
CHUNK_OVERLAP=150
# Hierarchical chunking: child chunks are searched; parent chunks are supplied as answer context.
PARENT_CHUNK_SIZE=1800
PARENT_CHUNK_OVERLAP=250
CHROMA_COLLECTION=rag_documents
TOP_K=3
SIMILARITY_THRESHOLD=0.08
# vector | bm25 | hybrid
RETRIEVAL_STRATEGY=hybrid
HYBRID_VECTOR_WEIGHT=0.65
# Hashing is local/offline and requires no embedding API key.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768
# none | lexical (lightweight local reranker)
RERANKER=lexical
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
TEMPERATURE=0.1
# Required for Groq generation. Add your own key only to .env.
GROQ_API_KEY=
